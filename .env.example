# Contact form. All read at runtime, so a rotated key needs a restart, not a rebuild.
# In the cluster these come from the secret `sjolystinnovation-app-secrets`, created by
# tumo-platform/scripts/sjolystinnovation/bootstrap.sh.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sjølyst Innovation
CONTACT_TO_EMAIL=

# dev | prod. Anything but prod/production serves a robots.txt that disallows crawling.
SITE_ENV=dev
